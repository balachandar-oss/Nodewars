# ===================================================
# Node Wars - Environment Configuration Template
# ===================================================

# DATABASE CONFIGURATION
# Local Development (SQLite):
DATABASE_URL="file:./prisma/dev.db"
# Production (Render / PostgreSQL):
# DATABASE_URL="postgresql://user:password@host:5432/node_wars?sslmode=require"

# SERVER RUNTIME
PORT=3001
NODE_ENV=development

# SECURITY SECRETS (REQUIRED IN PRODUCTION)
# In production, set a strong, randomly generated key (min 32 characters)
JWT_SECRET="super-secret-node-wars-key-change-in-prod"

# ORGANIZER & ADMIN CREDENTIALS
# Fallback admin password (for /api/auth/admin-login)
ADMIN_PASSWORD="change-this-admin-password"

# Production Organizer Passwords (read at seed time for organizer accounts)
ORGANIZER_BALA_PASSWORD="change-this-bala-password"
ORGANIZER_VAISHNAV_PASSWORD="change-this-vaishnav-password"

# CORS & FRONTEND ORIGINS (REQUIRED FOR BACKEND IN PRODUCTION)
# URL of your Vercel deployment without trailing slash:
FRONTEND_URL="http://localhost:5173"
# Additional origins if needed:
# CORS_ORIGIN="https://your-app.vercel.app"
# SOCKET_CORS_ORIGIN="https://your-app.vercel.app"

# FRONTEND CONFIGURATION (apps/web)
# For Vercel environment variables, set:
# VITE_API_URL="https://your-backend.onrender.com"
