# Backend Environment Variables (Render Web Service)
# In production, Render provides PORT and you connect to PostgreSQL.

# DATABASE_URL="postgresql://user:password@host:5432/node_wars?sslmode=require"
DATABASE_URL="file:./prisma/dev.db"

PORT=3001
NODE_ENV=development

# JWT Secret (MUST be a strong random secret in production)
JWT_SECRET="super-secret-node-wars-key-change-in-prod"

# Allowed frontend origin (Vercel deployment URL without trailing slash)
FRONTEND_URL="http://localhost:5173"

# Admin & Organizer seed passwords
ADMIN_PASSWORD="change-this-admin-password"
ORGANIZER_BALA_PASSWORD="change-this-bala-password"
ORGANIZER_VAISHNAV_PASSWORD="change-this-vaishnav-password"
