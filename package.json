{
  "name": "node-wars",
  "version": "1.0.0",
  "description": "Node Wars - Engineering Lab",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev": "npm run dev:web & npm run dev:server",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "ts-node apps/server/src/utils/seed.ts",
    "db:generate:prod": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "db:push:prod": "prisma db push --schema=prisma/schema.postgresql.prisma",
    "db:deploy:prod": "prisma migrate deploy --schema=prisma/schema.postgresql.prisma"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0"
  }
}
